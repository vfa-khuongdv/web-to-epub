{
  "name": "web-to-epub",
  "version": "1.0.0",
  "description": "Extract rendered web page text (bypassing copy-protection) and export to Kindle-ready EPUB",
  "private": true,
  "main": "electron/main.js",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "tsc && npm run build -w frontend",
    "build:backend": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc --watch & nodemon dist/server.js",
    "dev:frontend": "npm run dev -w frontend",
    "test": "vitest run",
    "app:mac": "npm run build && npm run app:browser && npm run app:icon && electron-builder --mac --arm64",
    "app:browser": "PLAYWRIGHT_BROWSERS_PATH=\"$PWD/build/ms-playwright\" playwright install --only-shell chromium",
    "app:icon": "node scripts/make-icon.js"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "epub-gen": "^0.1.0",
    "express": "^4.19.2",
    "jsdom": "^24.1.0",
    "multer": "^1.4.5-lts.1",
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.5.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.4",
    "typescript": "^5.5.4",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "vn.webtoepub.app",
    "productName": "Web to EPUB",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "public/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/ms-playwright",
        "to": "ms-playwright"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "build/icon.icns"
    },
    "afterPack": "scripts/adhoc-sign.js"
  }
}
