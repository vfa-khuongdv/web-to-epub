{
  "name": "web-to-epub",
  "version": "1.9.1",
  "description": "Extract rendered web page text (bypassing copy-protection) and export to Kindle-ready EPUB",
  "author": "khuongdv",
  "repository": {
    "type": "git",
    "url": "https://github.com/vfa-khuongdv/web-to-epub.git"
  },
  "private": true,
  "license": "Apache-2.0",
  "main": "electron/main.js",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "tsc && npm run build -w frontend",
    "build:backend": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc --watch & nodemon --watch dist dist/server.js",
    "dev:frontend": "npm run dev -w frontend",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "app:mac": "npm run build && npm run app:browser && npm run app:icon && electron-builder --mac --arm64 --publish never",
    "app:win": "npm run build && npm run app:browser && electron-builder --win --x64 --publish never",
    "app:linux": "npm run build && npm run app:browser && electron-builder --linux --x64 --publish never",
    "app:browser": "node scripts/install-browser.js",
    "app:icon": "node scripts/make-icon.js"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "epub-gen": "^0.1.0",
    "express": "^4.19.2",
    "fflate": "^0.8.3",
    "jsdom": "^24.1.0",
    "multer": "^1.4.5-lts.1",
    "playwright": "^1.47.0",
    "sharp": "^0.35.4",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.5.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.4",
    "typescript": "^5.5.4",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "vn.webtoepub.app",
    "productName": "Web to EPUB",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "public/**",
      "electron/**",
      "!electron/**/*.test.ts",
      "tts/**",
      "agent/**",
      "package.json"
    ],
    "asarUnpack": [
      "tts/**",
      "agent/**"
    ],
    "extraResources": [
      {
        "from": "build/ms-playwright",
        "to": "ms-playwright"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon-1024.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "build/icon-1024.png",
      "maintainer": "vfa-khuongdv"
    },
    "afterPack": "scripts/adhoc-sign.js"
  },
  "overrides": {
    "ejs": "^3.1.10",
    "nth-check": "^2.1.1"
  }
}
