{
  "name": "web-to-epub",
  "version": "1.0.0",
  "description": "Extract rendered web page text (bypassing copy-protection) and export to Kindle-ready EPUB",
  "private": true,
  "main": "dist/server.js",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "tsc && npm run build -w frontend",
    "build:backend": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc --watch & nodemon dist/server.js",
    "dev:frontend": "npm run dev -w frontend",
    "test": "vitest run"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "epub-gen": "^0.1.0",
    "express": "^4.19.2",
    "jsdom": "^24.1.0",
    "multer": "^1.4.5-lts.1",
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.5.0",
    "nodemon": "^3.1.4",
    "typescript": "^5.5.4",
    "vitest": "^5.0.1"
  }
}
